<?xml version="1.0" encoding="utf-8"?>
<!-- Botão circular dos controles laterais de vídeo (v0.22.26): fundo
     escuro com leve gradiente (mais claro no topo) pra dar volume ao disco
     em vez do preto chapado. O scrim atrás dos controles garante o
     contraste do ícone em qualquer cena do vídeo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:centerColor="#7A000000"
        android:endColor="#59000000"
        android:startColor="#8C000000"
        android:type="linear" />
</shape>
